      "html": "<label class=\"ds-field-label\" for=\"ds-listing\">Vehicle listing URL</label><input class=\"ds-field\" id=\"ds-listing\" type=\"url\" placeholder=\"Paste an eBay.ca car link\">",
      "css": ".ds-field-label{display:block;margin-bottom:12px;font-family:var(--font-body,'Satoshi',sans-serif);color:var(--text,#1d1d67);font-size:16px;font-weight:600}.ds-field{width:100%;min-height:48px;padding:12px;background:var(--background,#fdfdff);color:var(--text,#1d1d67);border:1px solid var(--border,#9494b8);border-radius:var(--radius-control,8px);font-family:var(--font-body,'Satoshi',sans-serif);font-size:16px;caret-color:var(--accent,#4545ba)}.ds-field::placeholder{color:var(--text-secondary,#585878);opacity:1}.ds-field:focus-visible{outline:3px solid var(--accent,#4545ba);outline-offset:4px;}.ds-field[aria-invalid=true]{border-color:var(--error,#b12f48)}"
    },
