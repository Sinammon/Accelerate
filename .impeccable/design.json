  "components": [
    {
      "name": "Add car",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Compact primary action; busy/full labels are explicit in the live form.",
      "html": "<button class=\"ds-primary\">Add car</button>",
      "css": ".ds-primary{min-height:44px;padding:12px 20px;border:1px solid transparent;border-radius:8px;background:var(--action);color:var(--ink);font:640 16px/1.38 var(--font-sans);cursor:pointer;transition:background-color 160ms}.ds-primary:hover{background:var(--accent)}.ds-primary:disabled{opacity:.6;cursor:not-allowed}.ds-primary:focus-visible{outline:3px solid var(--accent);outline-offset:4px}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet action with an explicit interactive boundary.",
      "html": "<button class=\"ds-secondary\">Edit running costs</button>",
      "css": ".ds-secondary{min-height:44px;padding:8px 12px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text);font:640 14px var(--font-sans);cursor:pointer}.ds-secondary:hover{background:var(--surface-hover)}.ds-secondary:focus-visible{outline:3px solid var(--accent);outline-offset:4px}"
    },
    {
      "name": "Listing field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labeled listing URL field within the compact import form.",
      "html": "<label class=\"ds-label\" for=\"ds-url\">eBay.ca vehicle listing link</label><input id=\"ds-url\" class=\"ds-input\" type=\"url\" placeholder=\"https://www.ebay.ca/itm/...\">",
      "css": ".ds-label{display:block;margin-bottom:8px;color:var(--text);font:14px var(--font-sans)}.ds-input{min-height:48px;max-width:100%;padding:12px;border:1px solid var(--border);border-radius:8px;background:var(--background);color:var(--text);font:16px var(--font-sans)}.ds-input::placeholder{color:var(--text-secondary);opacity:1}.ds-input:hover{border-color:var(--accent)}.ds-input:focus-visible{outline:3px solid var(--accent);outline-offset:4px}"
    },
    {
      "name": "Selected view tab",
      "kind": "nav",
      "refersTo": "tab-selected",
      "description": "Selected-state sample; live tabs implement keyboard selection and labeled panels.",
      "html": "<button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Summary</button>",
      "css": ".ds-tab{min-height:44px;padding:10px 12px;border:1px solid transparent;border-radius:8px;background:var(--surface-hover);color:var(--accent);font:700 14px var(--font-sans);cursor:pointer}.ds-tab:hover{background:var(--surface-raised);color:var(--text)}.ds-tab:focus-visible{outline:3px solid var(--accent);outline-offset:4px}"
    },
    {
      "name": "Selected priority",
      "kind": "chip",
      "refersTo": "priority-selected",
      "description": "Pressed priority control; all six modes are available in the live workspace.",
      "html": "<button class=\"ds-priority\" aria-pressed=\"true\">Comfort</button>",
      "css": ".ds-priority{min-height:44px;padding:8px 12px;border:1px solid var(--accent);border-radius:8px;background:var(--accent);color:var(--ink);font:600 14px var(--font-sans);cursor:pointer}.ds-priority:hover{background:var(--action)}.ds-priority:focus-visible{outline:3px solid var(--accent);outline-offset:4px}"
    },
    {
      "name": "Evidence disclosure",
      "kind": "custom",
      "refersTo": "disclosure",
      "description": "Long explanation stays available behind a clear summary.",
      "html": "<details class=\"ds-details\"><summary>Full explanation &amp; model context</summary><p>Model evidence and estimates remain labeled.</p></details>",
      "css": ".ds-details{border-top:1px solid var(--border-subtle);color:var(--text-secondary);font:14px/1.5 var(--font-sans)}.ds-details summary{min-height:44px;padding:12px 0;cursor:pointer;color:var(--accent)}.ds-details summary:hover{color:var(--text)}.ds-details summary:focus-visible{outline:3px solid var(--accent);outline-offset:4px}"
    },
    {
      "name": "Floating listing composer",
      "kind": "custom",
      "refersTo": "hero-composer",
      "description": "Visual translation of the real hero import form; the application supplies validation and importing behavior.",
      "html": "<form class=\"ds-composer\"><label class=\"ds-visually-hidden\" for=\"ds-composer-url\">Your next car starts with a link</label><div class=\"ds-composer-row\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m10 13 4-4m-6 6-1 1a4 4 0 0 1-6-6l4-4a4 4 0 0 1 6 0m2 2 1-1a4 4 0 0 1 6 6l-4 4a4 4 0 0 1-6 0\"/></svg><input id=\"ds-composer-url\" type=\"url\" required placeholder=\"Paste an eBay.ca car link?\"></div><div class=\"ds-composer-actions\"><span class=\"ds-composer-chip\">eBay.ca</span><span class=\"ds-composer-count\">Up to 4 cars</span><button type=\"submit\" aria-label=\"Import\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\"/></svg></button></div></form>",
      "css": ".ds-composer{max-width:672px;padding:16px;border-radius:24px;background:var(--color-neutral-white,#FFFFFF);color:var(--color-secondary-950,#041222);box-shadow:0 20px 25px -5px rgb(4 18 34 / .2),0 8px 10px -6px rgb(4 18 34 / .2);font-family:var(--font-sans,Satoshi,sans-serif)}.ds-composer:focus-within{outline:2px solid var(--color-primary-600,#0872E6)}.ds-composer-row{display:flex;align-items:center;gap:12px;padding:0 4px}.ds-composer-row svg{flex-shrink:0;color:var(--color-neutral-500,#64798C)}.ds-composer input{flex:1;width:100%;min-width:0;min-height:48px;padding:8px 0;border:0;background:transparent;color:inherit;font:400 16px/1.55 var(--font-sans,Satoshi,sans-serif)}.ds-composer input::placeholder{color:var(--color-neutral-600,#46596C);opacity:1}.ds-composer input:focus-visible{outline:none}.ds-composer-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:8px}.ds-composer-chip,.ds-composer-count{display:inline-flex;align-items:center;min-height:32px;padding:0 12px;border-radius:calc(infinity * 1px);background:var(--color-neutral-100,#F0F6FA);font-size:12px}.ds-composer-count{color:var(--color-neutral-600,#46596C)}.ds-composer button{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;min-height:44px;margin-left:auto;padding:0;border:0;border-radius:calc(infinity * 1px);background:var(--color-primary-600,#0872E6);color:var(--color-neutral-white,#FFFFFF);cursor:pointer;transition:background-color 160ms}.ds-composer button:hover,.ds-composer button:active{background:var(--color-primary-700,#0759B8)}.ds-composer button:focus-visible{outline:3px solid var(--accent,#0759B8);outline-offset:4px}.ds-composer button:disabled{opacity:.5;cursor:not-allowed}.ds-visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}:host-context(.dark) .ds-composer{background:var(--color-secondary-800,#102C47);color:var(--color-neutral-50,#F8FBFD);box-shadow:0 20px 25px -5px rgb(0 0 0 / .2),0 8px 10px -6px rgb(0 0 0 / .2)}:host-context(.dark) .ds-composer:focus-within{outline-color:var(--color-primary-400,#4BA9FF)}:host-context(.dark) .ds-composer input::placeholder{color:var(--color-neutral-300,#CBD7E0)}:host-context(.dark) .ds-composer-chip,:host-context(.dark) .ds-composer-count{background:var(--color-secondary-700,#1A3C59);color:var(--color-neutral-100,#F0F6FA)}:host-context(.dark) .ds-composer button{background:var(--color-primary-400,#4BA9FF);color:var(--color-secondary-950,#041222)}:host-context(.dark) .ds-composer button:hover{background:var(--color-primary-300,#85C5FF)}@media(max-width:639px){.ds-composer-count{display:none}}"
