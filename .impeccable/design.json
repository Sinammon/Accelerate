  "narrative": {
    "northStar": "A familiar welcome, a clear comparison",
    "overview": "The restored navy/electric-blue home dashboard welcomes shoppers with its floating import composer, source strip, editorial section and horizon. Working screens remain compact and use the full content width, with no left sidebar. Compare displays contained vehicle photos above the six-row overview. A header Cars menu keeps removal and selected-car source access available. Compare supports inline import from its heading or the header action, plus per-car removal beside each photo. Recommendations present complete reasons and model context once in the main card, with no repeated explanation disclosure.",
    "keyCharacteristics": [
      "Compact hierarchy, flat surfaces and explicit selected states.",
      "Satoshi interface text with the retained Clash Grotesk wordmark.",
      "Progressive disclosure for explanation without hiding trade-offs or warnings.",
      "Theme-aware evidence labels and contained, credited vehicle photography."
    ],
    "rules": [
      {
        "name": "The Semantic Surface Rule",
        "body": "Pair surface and text roles from the same theme; do not reintroduce fixed navy panels beneath theme-dependent dark text.",
        "section": "colors"
      },
      {
        "name": "The Evidence Rule",
        "body": "State warnings, uncertainty and provenance in words as well as color.",
        "section": "colors"
      },
      {
        "name": "The Compact Hierarchy Rule",
        "body": "Use compact working roles and reserve larger display, metric and atmospheric treatments for the restored home.",
        "section": "typography"
      },
      {
        "name": "The Task Depth Rule",
        "body": "Use tonal separation and boundaries for working content; reserve overlay depth for an actual dialog or menu.",
        "section": "elevation"
      },
      {
        "name": "Direct comparison actions",
        "body": "Keep adding and removing cars on Compare; show the recommendation explanation once and fully, with citations and visible trade-offs and warnings.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** use semantic palette roles in both themes.",
      "**Do** keep the compact type ramp, 8px controls and 12px main surfaces intentional and consistent.",
      "**Do** retain complete vehicle photographs and existing attribution.",
      "**Do** keep trade-offs, warnings and estimate labels visible while disclosing longer explanations.",
      "**Do** preserve keyboard focus, source access and the shared shortlist across task views."
    ],
    "donts": [
      "**Don't** replace evidence wording with color alone or imply individual condition is verified.",
      "**Don't** treat source checks, test passes or CSS breakpoints as rendered desktop, phone or zoom approval.",
      "**Don't** add new identity assets, palette families or decorative raster work to this compact system.",
      "**Don't** restore the left shortlist sidebar or stretch/crop car images in Compare."
