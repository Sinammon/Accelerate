    {
      "name": "Divider metric grid",
      "kind": "custom",
      "refersTo": "metric-grid",
      "description": "Two-column product-fact description list with fine dividers and a token-aware diamond at their intersection.",
      "html": "<dl class=\"ds-metrics\"><div><span class=\"ds-dot\" aria-hidden=\"true\"></span><dt>Cars in one shortlist</dt><dd>4</dd></div><div><span class=\"ds-dot\" aria-hidden=\"true\"></span><dt>Ways to find your match</dt><dd>6</dd></div><div><span class=\"ds-dot\" aria-hidden=\"true\"></span><dt>Clearer comparison</dt><dd>1</dd></div><div><span class=\"ds-dot\" aria-hidden=\"true\"></span><dt>Accounts required</dt><dd>0</dd></div></dl>",
      "css": ".ds-metrics{position:relative;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin:0;color:var(--text,#041222);font-family:var(--font-sans,Satoshi,sans-serif)}.ds-metrics>div{display:flex;flex-direction:column;min-width:0;padding:24px 0;border-color:var(--border-subtle,#E3EBF1);border-style:solid;border-width:0}.ds-metrics>div:nth-child(-n+2){border-bottom-width:1px}.ds-metrics>div:nth-child(odd){border-right-width:1px;padding-right:24px}.ds-metrics>div:nth-child(even){padding-left:24px}.ds-dot{display:block;width:8px;height:8px;margin-bottom:24px;border-radius:calc(infinity * 1px);background:var(--color-primary-600,#0872E6)}.ds-metrics dt{order:2;max-width:208px;margin-top:16px;font-size:14px;line-height:1.625;color:var(--text-secondary,#46596C)}.ds-metrics dd{order:1;margin:0;font-size:48px;font-weight:500;line-height:1;letter-spacing:-.025em}:host-context(.dark) .ds-dot{background:var(--color-primary-400,#4BA9FF)}@media(min-width:640px){.ds-metrics dd{font-size:60px}.ds-metrics>div:nth-child(odd){padding-right:40px}.ds-metrics>div:nth-child(even){padding-left:40px}}.ds-metrics::after{content:\"\";pointer-events:none;position:absolute;left:50%;top:50%;width:8px;height:8px;transform:translate(-50%,-50%) rotate(45deg);background:var(--color-primary-200,#B9DFFF)}:host-context(.dark) .ds-metrics::after{background:var(--color-secondary-400,#5989B2)}"
    },
