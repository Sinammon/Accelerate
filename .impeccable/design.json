      "html": "<button class=\"ds-button-primary\">Import a car</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;padding:12px 20px;border:1px solid transparent;border-radius:var(--radius-control,8px);font-family:var(--font-body,'Satoshi',sans-serif);font-size:16px;font-weight:640;line-height:1.38;cursor:pointer;transition:background-color 160ms,border-color 160ms;background:var(--action,#4c4ccc);color:var(--ink,#ffffff)}.ds-button-primary:hover{background:var(--accent,#4545ba)}.ds-button-primary:focus-visible{outline:3px solid var(--accent,#4545ba);outline-offset:4px;}.ds-button-primary:disabled{opacity:.6;cursor:not-allowed}"
    },
