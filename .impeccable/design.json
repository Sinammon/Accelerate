  "components": [
    {
      "name": "Add car",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Compact primary action; busy/full labels are explicit in the live form.",
      "html": "<button class=\"ds-primary\">Add car</button>",
      "css": ".ds-primary{min-height:44px;padding:12px 20px;border:1px solid transparent;border-radius:8px;background:var(--action);color:var(--ink);font:640 16px/1.38 var(--font-sans);cursor:pointer;transition:background-color 160ms}.ds-primary:hover{background:var(--accent)}.ds-primary:disabled{opacity:.6;cursor:not-allowed}.ds-primary:focus-visible{outline:3px solid var(--accent);outline-offset:4px}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet action with an explicit interactive boundary.",
      "html": "<button class=\"ds-secondary\">Edit running costs</button>",
      "css": ".ds-secondary{min-height:44px;padding:8px 12px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--text);font:640 14px var(--font-sans);cursor:pointer}.ds-secondary:hover{background:var(--surface-hover)}.ds-secondary:focus-visible{outline:3px solid var(--accent);outline-offset:4px}"
    },
    {
      "name": "Listing field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labeled listing URL field within the compact import form.",
      "html": "<label class=\"ds-label\" for=\"ds-url\">eBay.ca vehicle listing link</label><input id=\"ds-url\" class=\"ds-input\" type=\"url\" placeholder=\"https://www.ebay.ca/itm/...\">",
      "css": ".ds-label{display:block;margin-bottom:8px;color:var(--text);font:14px var(--font-sans)}.ds-input{min-height:48px;max-width:100%;padding:12px;border:1px solid var(--border);border-radius:8px;background:var(--background);color:var(--text);font:16px var(--font-sans)}.ds-input::placeholder{color:var(--text-secondary);opacity:1}.ds-input:hover{border-color:var(--accent)}.ds-input:focus-visible{outline:3px solid var(--accent);outline-offset:4px}"
    },
    {
      "name": "Selected view tab",
      "kind": "nav",
      "refersTo": "tab-selected",
      "description": "Selected-state sample; live tabs implement keyboard selection and labeled panels.",
      "html": "<button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Summary</button>",
      "css": ".ds-tab{min-height:44px;padding:10px 12px;border:1px solid transparent;border-radius:8px;background:var(--surface-hover);color:var(--accent);font:700 14px var(--font-sans);cursor:pointer}.ds-tab:hover{background:var(--surface-raised);color:var(--text)}.ds-tab:focus-visible{outline:3px solid var(--accent);outline-offset:4px}"
    },
    {
      "name": "Selected priority",
      "kind": "chip",
      "refersTo": "priority-selected",
      "description": "Pressed priority control; all six modes are available in the live workspace.",
      "html": "<button class=\"ds-priority\" aria-pressed=\"true\">Comfort</button>",
      "css": ".ds-priority{min-height:44px;padding:8px 12px;border:1px solid var(--accent);border-radius:8px;background:var(--accent);color:var(--ink);font:600 14px var(--font-sans);cursor:pointer}.ds-priority:hover{background:var(--action)}.ds-priority:focus-visible{outline:3px solid var(--accent);outline-offset:4px}"
    },
    {
      "name": "Import surface",
      "kind": "card",
      "refersTo": "import-surface",
      "description": "Flat compact container for the working form.",
      "html": "<section class=\"ds-surface\"><strong>Add a listing</strong><p>Compare up to four cars.</p></section>",
      "css": ".ds-surface{padding:24px;border:1px solid var(--border-subtle);border-radius:12px;background:var(--surface);color:var(--text);font:16px/1.55 var(--font-sans)}.ds-surface p{margin:8px 0 0;color:var(--text-secondary);font-size:14px}"
    },
    {
      "name": "Shortlist rail",
      "kind": "custom",
      "refersTo": "shortlist",
      "description": "Compact persistent context; the live rail includes photos, concerns and removal.",
      "html": "<aside class=\"ds-shortlist\"><h2>Your shortlist <span>0/4</span></h2><p>Add a few cars you're considering.</p><button>Add a car</button></aside>",
      "css": ".ds-shortlist{width:232px;max-width:100%;padding:16px;border:1px solid var(--border-subtle);border-radius:12px;background:var(--surface);color:var(--text);font:14px/1.5 var(--font-sans)}.ds-shortlist h2{font-size:16px;margin:0 0 16px}.ds-shortlist span,.ds-shortlist p{font-size:14px;color:var(--text-secondary)}.ds-shortlist button{width:100%;min-height:44px;padding:8px 12px;border:1px solid var(--border-subtle);border-radius:8px;background:var(--surface-hover);color:var(--accent);font:600 14px var(--font-sans);cursor:pointer}.ds-shortlist button:hover{background:var(--surface-raised)}.ds-shortlist button:focus-visible{outline:3px solid var(--accent);outline-offset:4px}"
    },
    {
      "name": "Evidence disclosure",
      "kind": "custom",
      "refersTo": "disclosure",
      "description": "Long explanation stays available behind a clear summary.",
      "html": "<details class=\"ds-details\"><summary>Full explanation &amp; model context</summary><p>Model evidence and estimates remain labeled.</p></details>",
      "css": ".ds-details{border-top:1px solid var(--border-subtle);color:var(--text-secondary);font:14px/1.5 var(--font-sans)}.ds-details summary{min-height:44px;padding:12px 0;cursor:pointer;color:var(--accent)}.ds-details summary:hover{color:var(--text)}.ds-details summary:focus-visible{outline:3px solid var(--accent);outline-offset:4px}"
    }
  ],
  "narrative": {
    "northStar": "The Clear Shortlist",
    "overview": "Accelerate is a compact task workspace. Electric blue identifies actions and selection; deep navy anchors text and dark-theme surfaces. White and pale surfaces, fine dividers and restrained spacing keep comparisons and evidence easy to scan.\n\nThe slanted Accelerate wordmark and self-hosted Satoshi/Clash Grotesk pairing retain the identity. Brand expression comes through typography, palette and useful vehicle photographs. The approved compact system replaces the cinematic hero, atmospheric bands, floating composer and long editorial landing page.",
    "keyCharacteristics": [
      "Compact hierarchy, flat surfaces and explicit selected states.",
      "Satoshi interface text with the retained Clash Grotesk wordmark.",
      "Progressive disclosure for explanation without hiding trade-offs or warnings.",
      "Theme-aware evidence labels and contained, credited vehicle photography."
    ],
    "rules": [
      {
        "name": "The Semantic Surface Rule",
        "body": "Pair surface and text roles from the same theme; do not reintroduce fixed navy panels beneath theme-dependent dark text.",
        "section": "colors"
      },
      {
        "name": "The Evidence Rule",
        "body": "State warnings, uncertainty and provenance in words as well as color.",
        "section": "colors"
      },
      {
        "name": "The Compact Hierarchy Rule",
        "body": "Use the documented compact roles; reserve the larger import headline for the short entry task.",
        "section": "typography"
      },
      {
        "name": "The Task Depth Rule",
        "body": "Use tonal separation and boundaries for working content; reserve overlay depth for an actual dialog or menu.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use semantic palette roles in both themes.",
      "**Do** keep the compact type ramp, 8px controls and 12px main surfaces intentional and consistent.",
      "**Do** retain complete vehicle photographs and existing attribution.",
      "**Do** keep trade-offs, warnings and estimate labels visible while disclosing longer explanations.",
      "**Do** preserve keyboard focus, source access and the shared shortlist across task views."
    ],
    "donts": [
      "**Don't** restore cinematic hero bands, atmospheric panels or floating-composer examples as current workspace guidance.",
      "**Don't** replace evidence wording with color alone or imply individual condition is verified.",
      "**Don't** treat source checks, test passes or CSS breakpoints as rendered desktop, phone or zoom approval.",
      "**Don't** add new identity assets, palette families or decorative raster work to this compact system."
    ]
  }
}
